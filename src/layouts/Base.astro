---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/base.css';

interface Props {
  title: string;
  description: string;
  theme: 'read' | 'play';
}
const { title, description, theme } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Link-preview card (WhatsApp, LinkedIn, Slack, X, iMessage). Crawlers need an absolute URL.
const ogImage = new URL('/og.png', Astro.site);
const ogImageAlt = 'Pushpendra Yadav · Staff Frontend Engineer: I build the frontend platforms other engineers build on.';
---

<!doctype html>
<html lang="en" data-mode={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content={theme === 'read' ? '#F3F2EE' : '#161513'} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Pushpendra Yadav" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <!-- Zero-JS page morphs (CSS cross-document view transitions) and hover prerendering. -->
    <script type="speculationrules" is:inline>
      {
        "prerender": [{ "where": { "href_matches": ["/", "/play"] }, "eagerness": "moderate" }]
      }
    </script>
  </head>
  <body class={theme === 'read' ? 'body-read' : 'body-play'}>
    <slot />
  </body>
</html>
